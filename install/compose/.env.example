# Copy to ".env" (same folder as docker-compose.yaml) and edit. Never commit the real .env.

# Host port; change when running alongside another server using 4040.
SONARA_PORT=4040

# Absolute path to your music library (mounted read-only).
MUSIC_DIR=/path/to/your/music
PODCAST_DIR=./podcasts
PLAYLIST_DIR=./playlists

# Required. It is embedded in a connection string, so use letters and digits only.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional database name. Set to a restored database name before starting Sonara after recovery.
SONARA_DATABASE=sonara

# Optional: initial admin password, used only on the very first start.
# Leave empty and a random one is printed in the container log instead.
SONARA_ADMIN_PASSWORD=

# Optional: podcast search through podcastindex.org. Register for a free API key and secret at
# https://api.podcastindex.org . Without them you can still add podcasts by pasting a feed address.
PODCASTINDEX_API_KEY=
PODCASTINDEX_API_SECRET=

# Optional writable upload mount; register /var/uploads in Settings and allow uploads.
UPLOAD_DIR=./uploads
